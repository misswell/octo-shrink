{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctoShrink",
  "version": "2.5.4",
  "identifier": "com.misswell.octoshrink",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OctoShrink",
        "width": 760,
        "height": 680,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 23 },
        "hiddenTitle": true,
        "backgroundColor": "#f8f6f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQzI1OTkzOTAwNUQ4NwpSV1NIWFFBNW1TWDhBM01QSGFPOEFKQWp2UjFaVG4wbGUxdVYxaE5MWFN3am00Y3hyc0NGblVDQgo=",
      "endpoints": [
        "https://github.com/misswell/octo-shrink/releases/latest/download/latest.json"
      ]
    }
  }
}
