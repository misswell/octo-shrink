{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the standalone compare window",
  "windows": ["main", "compare"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-select-files",
    "allow-select-folder",
    "allow-select-output-dir",
    "allow-expand-image-files",
    "allow-compress-files",
    "allow-compress-smart",
    "allow-compress-single",
    "allow-cancel-file",
    "allow-clear-cancel-queue",
    "allow-save-file",
    "allow-open-in-finder",
    "allow-read-image-dataurl",
    "allow-get-app-version",
    "allow-restore-original",
    "allow-export-all",
    "allow-get-file-sizes",
    "allow-restore-all",
    "allow-set-startup-theme",
    "allow-check-for-update",
    "allow-install-update",
    "allow-cancel-update",
    "allow-open-compare-window",
    "allow-take-compare-window-payload",
    "allow-pause-compression",
    "allow-resume-compression",
    "allow-get-compression-state",
    "allow-list-history",
    "allow-clear-history",
    "allow-restore-history-entry",
    "allow-get-app-settings",
    "allow-set-original-retention-days",
    "allow-set-cpu-thread-limit",
    "allow-get-cpu-resource-settings",
    "allow-get-cpu-info"
  ],
  "remote": {
    "urls": [
      "http://localhost:41845",
      "http://localhost:41846",
      "http://localhost:41847"
    ]
  }
}
